<?xml version="1.0" encoding="UTF-8"?><manifest versionCode="101" versionName="1.1" compileSdkVersion="30" compileSdkVersionCodename="11" package="com.google.android.tag" platformBuildVersionCode="30" platformBuildVersionName="11">
